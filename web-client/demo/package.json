{
  "name": "@veil/demo",
  "version": "0.2.0",
  "private": true,
  "description": "Veil demo application",
  "scripts": {
    "build": "esbuild app.ts --bundle --outfile=app.js --format=esm --target=es2022",
    "dev": "esbuild app.ts --bundle --outfile=app.js --format=esm --target=es2022 --watch=forever",
    "serve": "npx http-server . -p 7800 --cors -c-1"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "http-server": "^14.0.0",
    "typescript": "^5.6.0"
  }
}
